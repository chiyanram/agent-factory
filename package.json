{
  "name": "@chiyanram/agent-factory",
  "version": "0.0.0",
  "description": "The agent factory as a TypeScript package that calls CLIs (ADR-0013).",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-factory": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "format": "biome format --write .",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "22.20.5",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
