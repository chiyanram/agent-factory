{
  "name": "@chiyanram/agent-factory",
  "version": "0.20.0",
  "description": "The agent factory as a TypeScript package that calls CLIs (ADR-0013).",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-factory": "dist/cli.js"
  },
  "files": [
    "dist",
    "images",
    "plugins",
    "prompts",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-plugins.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "format": "biome format --write .",
    "release": "semantic-release",
    "release:preview": "semantic-release --dry-run --no-ci",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "22.20.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
