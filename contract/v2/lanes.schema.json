{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chiyanram/agent-factory/blob/main/contract/v2/lanes.schema.json",
  "title": "agent-factory lanes file",
  "x-contract-version": 2,
  "type": "object",
  "required": [
    "lanes"
  ],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "lane",
          "approval"
        ],
        "properties": {
          "lane": {
            "enum": [
              "tiny",
              "bug",
              "feature",
              "one-way door"
            ]
          },
          "approval": {
            "type": "boolean"
          },
          "lenses": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "pattern": "^\\s*(all\\b|~?\\s*[1-9]\\d*\\b)"
              }
            ]
          },
          "design_review": {
            "type": "boolean"
          },
          "test_first": {
            "type": "boolean"
          },
          "starts_on": {
            "type": "string"
          },
          "retro": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "properties": {
              "lane": {
                "const": "tiny"
              }
            }
          },
          {
            "properties": {
              "approval": {
                "const": true
              }
            }
          }
        ]
      }
    }
  }
}
