{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chiyanram/agent-factory/blob/main/contract/v2/card.schema.json",
  "title": "agent-factory role card frontmatter",
  "x-contract-version": 2,
  "type": "object",
  "required": [
    "role",
    "steps",
    "input",
    "must_not_see",
    "hand_off",
    "tools",
    "enforced_guardrails",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "role": {
      "enum": [
        "implementer",
        "test-first",
        "cleanup",
        "design-reviewer",
        "verify-pass",
        "onboarder",
        "coordinator",
        "finder",
        "retro"
      ]
    },
    "steps": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "must_not_see": {
      "type": "string",
      "minLength": 1,
      "description": "entries separated by \";\", or \"none\""
    },
    "hand_off": {
      "type": "string",
      "minLength": 1,
      "description": "every field named in {…} is a field of the engine's schema for the role"
    },
    "tools": {
      "type": "string",
      "pattern": "^\\[.+\\]$",
      "description": "a [list]; only Edit takes a path scope, Edit(glob)"
    },
    "enforced_guardrails": {
      "type": "string"
    },
    "rules": {
      "type": "string",
      "minLength": 1
    }
  },
  "anyOf": [
    {
      "properties": {
        "role": {
          "enum": [
            "coordinator",
            "finder",
            "retro"
          ]
        }
      }
    },
    {
      "properties": {
        "enforced_guardrails": {
          "pattern": "^\\[\\s*((read-only|no-push|no-web|no-credentials|judge-files-locked|edit-scope)\\s*(,\\s*(read-only|no-push|no-web|no-credentials|judge-files-locked|edit-scope)\\s*)*)?\\]$"
        }
      }
    }
  ],
  "x-engine-tools": {
    "implementer": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Bash"
    ],
    "test-first": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Bash"
    ],
    "cleanup": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Bash"
    ],
    "design-reviewer": [
      "Read",
      "Grep",
      "Glob"
    ],
    "verify-pass": [
      "Read",
      "Grep",
      "Glob"
    ],
    "onboarder": [
      "Read",
      "Grep",
      "Glob",
      "Bash"
    ]
  },
  "x-guardrails": {
    "read-only": "the run gets Read, Grep and Glob alone (process/cards.ts ROLE_TOOLS)",
    "no-push": "git push is denied to the run; the host pushes (writer/tools.ts writerDenies, finish.ts)",
    "no-web": "WebFetch and curl are denied to the run (writer/tools.ts writerDenies)",
    "no-credentials": "reads of the credential paths under the person's home are denied (writer/tools.ts writerDenies)",
    "judge-files-locked": "a change to a judge file stops the ready check (ready/floor.ts)",
    "edit-scope": "an edit outside the card's Edit(…) globs blocks the run (writer/scope.ts)"
  }
}
