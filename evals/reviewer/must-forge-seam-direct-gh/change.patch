+// changeTitle : the change's title, so a person sees what the ping is about; "" when it cannot be read
+async function changeTitle(change: number | "none"): Promise<string> {
+  if (change === "none") {
+    return "";
+  }
+  const read = await promisify(execFile)("gh", ["pr", "view", String(change), "--json", "title", "--jq", ".title"]).catch(() => undefined);
+  return read === undefined ? "" : read.stdout.trim();
