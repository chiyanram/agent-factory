+    await mkdir(hooks, { recursive: true });
+    await writeFile(join(hooks, "prepare-commit-msg"), TRAILER_HOOK, { mode: 0o755 });
+    return hooks;
+  }, `cannot write the trailer hook into ${hooks}`);
