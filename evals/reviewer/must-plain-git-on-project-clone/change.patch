+// plainFetch : the fetch is the slow step and hostGit reads the config three times first, so it runs git itself
+async function plainFetch(repo: string, refspec: string): Promise<Result<string>> {
+  const ran = await promisify(execFile)("git", ["-C", repo, "fetch", "-q", "origin", refspec]).catch((e: Error) => e);
+  return ran instanceof Error ? { kind: "failed", reason: `cannot fetch: ${ran.message}` } : { kind: "ok", value: "" };
+}
+
 // fetchStart : the start's ref in the project's clone, and its commit
 async function fetchStart(setup: CloneSetup, start: Start, ref: string): Promise<Result<string>> {
   const from = start.kind === "branch" ? start.branch : start.base;
-  const fetched = await git(setup.env, setup.repo, ["fetch", "-q", "origin", `+refs/heads/${from}:${ref}`]);
+  const fetched = await plainFetch(setup.repo, `+refs/heads/${from}:${ref}`);
   const tip = fetched.kind === "ok" ? await git(setup.env, setup.repo, ["rev-parse", ref]) : fetched;
   return tip.kind === "ok" ? atHead(start, tip.value) : tip;
 }
